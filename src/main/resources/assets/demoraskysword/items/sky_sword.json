{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "demoraskysword:item/sky_sword"
        }
      },
      {
        "when": "none",
        "model": {
          "type": "minecraft:model",
          "model": "demoraskysword:item/sky_sword_giant"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "demoraskysword:item/sky_sword_3d"
    }
  }
}